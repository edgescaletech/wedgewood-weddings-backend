# Salesforce
SF_MY_DOMAIN_URL=https://yourorg.my.salesforce.com
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here
# SF_ACCESS_TOKEN=

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# WorkOS AuthKit (never commit real secrets)
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_REDIRECT_URI=http://localhost:8080/auth/callback

# Match the exact issuer in your WorkOS session token, including any trailing slash.
WORKOS_ISSUER="https://api.workos.com/user_management/WORKOS_CLIENT_ID"

# Generate with: openssl rand -hex 32
WORKOS_COOKIE_PASSWORD=replace_with_at_least_32_random_bytes

# Browser application origin; must match Origin on logout and CORS requests.
APP_URL=http://localhost:8080
# Only set false for local HTTP development. Production requires HTTPS and true.
COOKIE_SECURE=false
