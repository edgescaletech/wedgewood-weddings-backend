# Salesforce Connected App credentials
# Copy this file to .env and fill in your values (never commit .env)

SF_MY_DOMAIN_URL=https://yourorg.my.salesforce.com
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here

# Optional: bypass OAuth by providing a direct access token (dev only)
# SF_ACCESS_TOKEN=

# Database (not needed for V1 — Salesforce is the source of truth)
# Add when you introduce a local DB (e.g. caching, user data, auth sessions)
# DATABASE_URL=postgres://user:password@localhost:5432/wedgewood?sslmode=disable
